# ══════════════════════════════════════════════════════════
# NutriScan AI — Environment Variables
# Copy to .env and fill in your values
# ══════════════════════════════════════════════════════════

# Flask
FLASK_ENV=development
SECRET_KEY=your-very-secret-key-change-this
PORT=5000

# Database
DATABASE_URL=sqlite:///food_health.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost/nutriscan

# Model paths (optional overrides)
MODEL_PATH=models/food_classifier.pth
MODEL_CLASSES_PATH=models/classes.json
NUTRITION_DB_PATH=dataset/nutrition_database.json

# Optional: External Nutrition API (USDA FoodData Central)
# Register at: https://fdc.nal.usda.gov/api-guide.html
USDA_API_KEY=your-usda-api-key-here
